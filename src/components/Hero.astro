---
import { Image } from 'astro:assets';
import hero from '../assets/photos/hero.jpg';
import Arrow from './Arrow.astro';

const stats = [
  { value: 'от 50 м²', label: 'площадь объектов' },
  { value: '10 этапов', label: 'от проекта до открытия' },
  { value: '17+', label: 'объектов с сентября' }, // TODO: уточнить число у заказчика
  { value: 'фудмолл «Депо»', label: 'наши корнеры' },
];
---

<section class="hero" data-hero>
  <Image
    class="hero-bg"
    src={hero}
    alt=""
    widths={[768, 1280, 1920, 2880]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="container hero-inner">
    <div class="hero-main">
      <h1 class="display">Открываем ваш бизнес под ключ</h1>
      <div class="hero-side">
        <p class="lead">Кафе, корнеры, магазины, шоурумы и офисы от 50 м². Проект, стройка, закупки и запуск ведёт одна команда.</p>
        <div class="hero-actions">
          <a class="btn btn-light" href="#anketa">Заполнить анкету <span class="arrow"><Arrow /></span></a>
          <a class="btn btn-ghost" href="#kejsy">Смотреть кейсы <span class="arrow"><Arrow /></span></a>
        </div>
      </div>
    </div>
    <ul class="stats">
      {
        stats.map((s) => (
          <li>
            <p class="stat-value">{s.value}</p>
            <p class="stat-label">{s.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 760px);
    display: flex;
    isolation: isolate;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* Затемнение как в макете: сверху под шапку, снизу под текст, слева под заголовок */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(14 14 15 / 0.55) 0%, rgb(14 14 15 / 0.15) 35%, rgb(14 14 15 / 0.45) 60%, rgb(14 14 15 / 0.95) 100%),
      linear-gradient(90deg, rgb(14 14 15 / 0.75) 0%, rgb(14 14 15 / 0.1) 60%, rgb(14 14 15 / 0.35) 100%);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 140px;
    padding-bottom: 36px;
  }

  .hero-main {
    display: grid;
    grid-template-columns: 1fr minmax(0, 470px);
    gap: 40px;
    align-items: end;
    padding-bottom: 40px;
  }

  .hero h1 {
    max-width: 780px;
  }

  .hero-side .lead {
    margin-bottom: 28px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    max-width: 470px;
    gap: 12px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: space-between;
    gap: 24px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .stat-value {
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .stat-label {
    margin-top: 8px;
    font-size: 14px;
    color: rgb(255 255 255 / 0.6);
    font-weight: 400;
  }

  @media (max-width: 1024px) {
    .hero-main {
      grid-template-columns: 1fr;
    }

    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero-inner {
      padding-top: 112px;
    }

    .hero-actions .btn {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
