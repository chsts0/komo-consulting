---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'cases'>;
  big?: boolean;
}

const { item, big = false } = Astro.props;
const { title, kind, place, summary, services, cover, coverAlt } = item.data;
---

<li class:list={['card', { big }]} data-case data-services={services.join('|')}>
  <a href={`/kejsy/${item.id}`}>
    <div class="photo">
      <Image
        src={cover}
        alt={coverAlt}
        widths={big ? [720, 1088, 1400] : [480, 720, 960]}
        sizes={big ? '(max-width: 1440px) 100vw, 1328px' : '(max-width: 860px) 100vw, 33vw'}
      />
    </div>
    <div class="info">
      <div>
        <h3 class:list={[big ? 'h2' : 'h3']}>{title}</h3>
        <p class="text">{kind} · {place}</p>
      </div>
      <div>
        <p class="summary">{summary}</p>
        <p class="caption">{services.join(' · ')}</p>
      </div>
    </div>
  </a>
</li>

<style>
  .card[hidden] {
    display: none;
  }

  .photo {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--black);
  }

  .big .photo {
    aspect-ratio: 1088 / 490;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  a:hover .photo :global(img) {
    transform: scale(1.03);
  }

  .info {
    display: grid;
    gap: 12px;
    padding-top: 24px;
  }

  .big .info {
    grid-template-columns: 1fr minmax(0, 440px);
    gap: 32px;
  }

  .info .text {
    margin-top: 8px;
    font-size: 14px;
  }

  .summary {
    font-size: 15px;
    font-weight: 400;
    margin-bottom: 10px;
  }

  .caption {
    font-size: 11px;
  }

  @media (max-width: 860px) {
    .big .info {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .big .photo {
      aspect-ratio: 4 / 3;
    }
  }
</style>
