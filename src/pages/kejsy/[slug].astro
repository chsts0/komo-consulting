---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import Arrow from '../../components/Arrow.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { title, kind, place, summary, services, cover, coverAlt, seoTitle, seoDescription } = item.data;
const { Content } = await render(item);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Кейсы', item: new URL('/kejsy', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
---

<Base
  title={seoTitle ?? `${title} · ${kind.toLowerCase()} | KOMO`}
  description={seoDescription ?? summary}
  ogImage={cover.src}
  jsonLd={[breadcrumbs]}
>
  <article class="section case">
    <div class="container">
      <a class="link back" href="/kejsy"><span class="flip"><Arrow /></span> Все кейсы</a>
      <header class="head">
        <h1 class="display">{title}</h1>
        <div>
          <p class="text">{kind} · {place}</p>
          <p class="caption">{services.join(' · ')}</p>
        </div>
      </header>
      <Image class="cover" src={cover} alt={coverAlt} widths={[720, 1088, 1400]} sizes="(max-width: 1440px) 100vw, 1328px" loading="eager" />
      <div class="body">
        <p class="lead">{summary}</p>
        <div class="content"><Content /></div>
      </div>
    </div>
  </article>
  <LeadForm />
</Base>

<style>
  .case {
    padding-top: 140px;
  }

  .back {
    margin-bottom: 48px;
  }

  .flip {
    display: inline-flex;
    transform: scaleX(-1);
  }

  .head {
    display: grid;
    grid-template-columns: 1fr minmax(0, 440px);
    gap: 32px;
    align-items: end;
    padding-bottom: 40px;
  }

  .head .text {
    margin-bottom: 8px;
  }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .body {
    display: grid;
    grid-template-columns: 1fr minmax(0, 640px);
    gap: 32px;
    padding-top: 48px;
  }

  .content {
    font-size: 18px;
    color: var(--light);
  }

  .content :global(p + p) {
    margin-top: 1em;
  }

  @media (max-width: 860px) {
    .case {
      padding-top: 112px;
    }

    .head,
    .body {
      grid-template-columns: 1fr;
    }

    .cover {
      aspect-ratio: 4 / 3;
    }
  }
</style>
